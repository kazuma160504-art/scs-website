# このファイルを .env.local にコピーして値を設定してください
# cp .env.example .env.local

# 部員名簿(/members)・連絡先(/contacts)の閲覧パスワード 兼 data/*.enc.json の復号鍵
# 部員に共有する合言葉を設定する（未設定時は開発用デフォルト "scs2022"）
# ⚠ この値を変更したら「npm run encrypt-data」で data/*.enc.json を必ず再生成すること
MEMBERS_PASSWORD=scs2022

